#Importing the import library for training the machine and visualizing the results
from sklearn.model_selection import train_test_split
from sklearn.linear_model import LogisticRegression
from sklearn.metrics import classification_report, confusion_matrix, accuracy_score, log_loss

X=newdata[["Observed Length (m)", "Observed Weight (kg)", "Sex Encoded"]]
y=newdata["Genus Encoded"]

#splitting the data for training set 70% and rest to 30%
X_train, X_tmp, y_train, y_tmp = train_test_split(X, y, test_size=0.30, random_state=42, stratify = y)

#splitting the rest of the data set into test and validation sets
X_val, X_test, y_val, y_test = train_test_split(X_tmp, y_tmp, test_size = 0.5, random_state = 42, stratify = y_tmp)

#Verifying the split
print(f"Training set size:{len(X_train)} ({len(X_train)/len(X)*100:.1f}%)")
print(f"Testing set size: {len(X_test)} ({len(X_test) /len(X)*100:.1f}%)")
print(f"Validation set size: {len(X_val)} ({len(X_val)/len(X)*100:.1f}%)")

#The logistic regression
log_regr = LogisticRegression(multi_class = "multinomial", max_iter = 1000, random_state = 42)
log_regr.fit(X_train, y_train)

#Predicting the probabilities
y_pred_proba_train = log_regr.predict_proba(X_train)
y_pred_proba_lr = log_regr.predict_proba(X_val)

#Calculating the log loss error
log_loss_train = log_loss(y_train, y_pred_proba_train)
log_loss_lr = log_loss(y_val, y_pred_proba_lr)
print(f'Logistic regression Log loss for training set: {log_loss_train}')
print(f'\nLogistic regression Log loss for validation: {log_loss_lr}')

#Prediction for the training set
train_predict = log_regr.predict(X_train)
train_accuracy = accuracy_score(y_train, train_predict)
print(f'\nTraining accuracy: {train_accuracy}')

#Prediction for the validation set
val_predict = log_regr.predict(X_val)
val_accuracy = accuracy_score(y_val, val_predict)
print(f"\nValidation accuracy: {val_accuracy}")

from sklearn.svm import SVC
from sklearn.metrics import hinge_loss, accuracy_score

#Training for SVC method
model = SVC(probability = True, random_state = 42)
model.fit(X_train, y_train)

#Predicting the probabilities
y_decision_svc = model.decision_function(X_val)
y_decision_svc_train = model.decision_function(X_train)

#Calculating the Hinge loss error
hinge_loss_svc = hinge_loss(y_val, y_decision_svc)
hinge_loss_svc_train = hinge_loss(y_train, y_decision_svc_train)
print(f'\nSVC hinge loss for training: {hinge_loss_svc_train}')
print(f'SVC hinge loss for validation: {hinge_loss_svc}')


#prediction for the training set
train_predic = model.predict(X_train)
train_accuracy = accuracy_score(y_train, train_predict)
print(f'\n Training accuracy: {train_accuracy}')

#Prediction for the validation set
val_predict = model.predict(X_val)
val_accuracy = accuracy_score(y_val, val_predict)
print(f"\nValidation accuracy: {val_accuracy}")

#predictind the probabilities for the test set
y_decision_svc_test = model.decision_function(X_test)

#Calculating the Hinge loss error
hinge_loss_svc_test = hinge_loss(y_test, y_decision_svc_test)
print(f'\nSVC hinge loss for test set: {hinge_loss_svc_test}')

#Prediction for the test set
test_predict = model.predict(X_test)
test_accuracy = accuracy_score(y_test, test_predict)
print(f'\nTest set accuracy: {test_accuracy}')

#Making a confusion matrix
conf_mat = confusion_matrix(y_test, test_predict)

plt.figure(figsize=(8,6))
sns.heatmap(conf_mat, annot = True, fmt= 'd', cmap='Blues',
           xticklabels = ['Crocodylus', 'Osteolaemus', 'Mecistops'],
           yticklabels = ['Crocodylus', 'Osteolaemus', 'Mecistops'])
plt.title("Confusion Matrix for test set")
plt.ylabel("True Genus")
plt.xlabel("Predicted Genus")

plt.show()

#Classification report
print("\nClassification Report:")
print(classification_report(y_test, test_predict, 
                           target_names=['Crocodylus', 'Osteolaemus', 'Mecistops']))

