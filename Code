#importing necessary libraries
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
import warnings
warnings.filterwarnings("ignore")
#reading the dataset
df = pd.read_csv(r"C:\Users\miilraut\Downloads\crocodile_dataset.csv")
df.head()

df.info()

#Checking if there are any duplicate rows
def check_and_drop_duplicate(df):
    if df.duplicated().sum() != 0:
        print(f'There are {df.duplicated().sum()} duplicated rows.')
        df = df.drop_duplicates().copy()
        print('Rows dropped successfully.')
    else:
        print('There are no duplicate rows.')
    return df

df = check_and_drop_duplicate(df)


df_encoded = df.copy()  #copying the code

#changing some of the variables to numbers instead of string, so the ML problem can be solved
sex_mapping = {"Male":0, "Female": 1}
genuses_mapping ={"Crocodylus" : 0, "Osteolaemus":1, "Mecistops":2}
conservation_status_mapping = {"Data Deficient":0, "Least Concern":1, "Vulnerable":2, "Critically Endagared":3}
df_encoded['Sex Encoded'] = df['Sex'].map(sex_mapping)
df_encoded['Genus Encoded'] = df['Genus'].map(genuses_mapping)
df_encoded['Conservation Encoded'] = df['Conservation Status'].map(conservation_status_mapping)

numerical_cols = ["Observed Length (m)", "Observed Weight (kg)", "Sex Encoded", "Genus Encoded","Conservation Encoded"]

#Making correlation matrix for the numerical variables
correlation_matrix = df_encoded[numerical_cols].corr()
sns.heatmap(correlation_matrix, annot=True, cmap='coolwarm', center=0)
plt.title("Correlation Heatmap")
plt.show()

#Dropping unneccessary variables for this project, aka preprocessing
df_encoded.drop(["Observation ID","Scientific Name", "Date of Observation", "Observer Name", "Notes", "Country/Region",
         "Habitat Type", "Conservation Status", "Genus", "Conservation Encoded", "Sex"], axis=1, inplace = True)

df_encoded.head()

newdata = df_encoded[(df_encoded["Age Class"] == 'Adult')&
                    (df_encoded["Sex Encoded"].isin([0, 1]))] #only keeping adult crocodiles and male and female individuals
